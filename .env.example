# Copy to .env on the server and fill in. .env is never committed.
#
# Generate the two secrets rather than inventing them by hand:
#   openssl rand -base64 48    # JWT_KEY
#   openssl rand -base64 24    # POSTGRES_PASSWORD

# ---------------- database ----------------
POSTGRES_USER=bullrealty
POSTGRES_PASSWORD=
POSTGRES_DB=bullrealty

# ---------------- API ----------------
# Signs every access token. Changing it signs everyone out, which is the
# correct response to it having leaked.
JWT_KEY=

# ---------------- public URLs ----------------
# What the browser calls. Both must be https in production — the access token
# travels on every request, and over http it travels in clear.
PUBLIC_WEB_URL=https://crm.example.com
PUBLIC_API_URL=https://api.crm.example.com

# ---------------------------------------------------------------------------
# The password the seeded accounts are created with.
#
# Leave it blank and a different random one is generated per install and
# printed once at startup. Set it to choose your own. It is never read from
# source, so it cannot end up in the repository.
# ---------------------------------------------------------------------------
Seed__AdminPassword=
